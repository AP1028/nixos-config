+QList<const char *> OpenconnectAuthWidget::webviewCookieArray(QList<QByteArray> &storage)
+{
+    Q_D(OpenconnectAuthWidget);
+
+    QList<const char *> arr;
+    storage.reserve(d->webviewCookies.size() * 2 + 1);
+    for (auto it = d->webviewCookies.constBegin(); it != d->webviewCookies.constEnd(); ++it) {
+        storage.append(it.key());
+        storage.append(it.value());
+    }
+    for (int i = 0; i < storage.size(); ++i) {
+        arr.append(storage.at(i).constData());
+    }
+    arr.append(nullptr);
+    return arr;
+}
