+// Register a freshly loaded PSB's resources, replacing stale entries from a
+// previous load of the same source (upstream's loop re-normalised the domain
+// repeatedly and never dropped old entries).
+static void registerPsbResources(PSBFile *self, ttstr path) {
+    PSBMedia *media = getPSBMedia();
+    if(media == nullptr) {
+        initPSBMedia();
+        media = getPSBMedia();
+    }
+    if(media == nullptr) {
+        LOGGER->error("psbfile: storage media is not initialised");
+        return;
+    }
+
+    media->NormalizeDomainName(path);
+
+    auto objs = self->getObjects();
+    if(!objs)
+        return;
+
+    media->removeByPrefix((path + TJS_W("/")).AsStdString());
+
+    for(const auto &[k, v] : *objs) {
+        const auto &res = std::dynamic_pointer_cast<PSBResource>(v);
+        if(res == nullptr)
+            continue;
+        ttstr pathN{ k };
+        media->NormalizePathName(pathN);
+        media->add((path + TJS_W("/") + pathN).AsStdString(), res);
+    }
+}
