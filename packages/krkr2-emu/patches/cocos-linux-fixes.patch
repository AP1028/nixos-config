--- a/cmake/Modules/FindFontconfig.cmake
+++ b/cmake/Modules/FindFontconfig.cmake
@@ -15,3 +15,12 @@
   VERSION_VAR FONTCONFIG_VERSION
   )
 
+
+# The patched cocos2d-x CMake links the namespaced target, which this module
+# never defined. Provide it from the pkg-config results.
+if(Fontconfig_FOUND AND NOT TARGET Fontconfig::Fontconfig)
+  add_library(Fontconfig::Fontconfig INTERFACE IMPORTED)
+  set_target_properties(Fontconfig::Fontconfig PROPERTIES
+    INTERFACE_INCLUDE_DIRECTORIES "${FONTCONFIG_INCLUDE_DIRS}"
+    INTERFACE_LINK_LIBRARIES "${FONTCONFIG_LIBRARIES}")
+endif()
