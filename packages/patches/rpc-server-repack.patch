diff -ruN A/ggml/src/ggml-cpu/repack.cpp B/ggml/src/ggml-cpu/repack.cpp
--- A/ggml/src/ggml-cpu/repack.cpp	2026-08-10 08:15:10.175136455 +0800
+++ B/ggml/src/ggml-cpu/repack.cpp	2026-08-10 08:15:10.176893933 +0800
@@ -4723,6 +4723,24 @@
     return nullptr;
 }
 
+
+// RPC servers: the client cannot know the remote hardware, so weights arrive
+// unrepacked via SET_TENSOR. Repack them in-place here (8x8 interleaved
+// layout) and tag the tensor so the CPU backend dispatches the fast
+// gemv/gemm path.
+extern "C" int ggml_backend_cpu_repack_tensor(struct ggml_tensor * t, const void * data, size_t data_size) {
+    const ggml::cpu::tensor_traits * traits = ggml_repack_get_optimal_repack_type(t);
+    if (traits == nullptr) {
+        return -1;
+    }
+    auto * traits_base = (ggml::cpu::repack::tensor_traits_base *) traits;
+    if (traits_base->repack(t, data, data_size) != 0) {
+        return -1;
+    }
+    t->extra = (void *) traits;
+    return 0;
+}
+
 static enum ggml_status ggml_backend_cpu_repack_buffer_init_tensor(ggml_backend_buffer_t buffer, struct ggml_tensor * tensor) {
     tensor->extra = (void *) const_cast<ggml::cpu::tensor_traits *>(ggml_repack_get_optimal_repack_type(tensor));
 
@@ -4812,6 +4830,11 @@
             if (op->src[0]->buffer && op->src[0]->buffer->buft == ggml_backend_cpu_repack_buffer_type()) {
                 return (ggml::cpu::tensor_traits *) op->src[0]->extra;
             }
+            // RPC servers: weights repacked in-place at SET_TENSOR time carry
+            // their traits in tensor->extra (the plain CPU buft never sets it).
+            if (op->src[0]->extra) {
+                return (ggml::cpu::tensor_traits *) op->src[0]->extra;
+            }
         }
         return nullptr;
     }
diff -ruN A/ggml/src/ggml-rpc/ggml-rpc.cpp B/ggml/src/ggml-rpc/ggml-rpc.cpp
--- A/ggml/src/ggml-rpc/ggml-rpc.cpp	2026-08-10 08:15:10.175196769 +0800
+++ B/ggml/src/ggml-rpc/ggml-rpc.cpp	2026-08-10 08:15:10.176941079 +0800
@@ -1,5 +1,7 @@
 #include "ggml-rpc.h"
 #include "ggml-impl.h"
+#include <dlfcn.h>
+
 #include "ggml-backend-impl.h"
 #include "ggml-cpp.h"
 #include "transport.h"
@@ -1216,6 +1218,24 @@
             return false;
         }
     }
+    // RPC server-side MXFP4 repack: the weights arrive once at load time with
+    // offset 0; repack them to the 8x8 interleaved layout in-place so the CPU
+    // backend can use the fast gemv/gemm path. The incoming data is a separate
+    // network buffer, so there is no aliasing. The repack entry point lives in
+    // the dlopen'd CPU backend library, so resolve it at runtime (a link-time
+    // reference would break libggml-rpc.so loading).
+    if (request.offset == 0 && size == ggml_nbytes(tensor) && tensor->type == GGML_TYPE_MXFP4) {
+        static int (*repack_fn)(struct ggml_tensor *, const void *, size_t) = nullptr;
+        if (repack_fn == nullptr) {
+            repack_fn = (int (*)(struct ggml_tensor *, const void *, size_t))
+                dlsym(RTLD_DEFAULT, "ggml_backend_cpu_repack_tensor");
+        }
+        if (repack_fn != nullptr && repack_fn(tensor, cached_file.data(), size) == 0) {
+            response.result = 1;
+            return true;
+        }
+        GGML_LOG_ERROR("[%s] repack failed for tensor %s, using unrepacked path\n", __func__, tensor->name);
+    }
     ggml_backend_tensor_set(tensor, cached_file.data(), request.offset, size);
     response.result = 1;
     return true;
