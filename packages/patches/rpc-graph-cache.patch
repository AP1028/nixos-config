 // assigns backends to ops and splits the graph into subgraphs that can be computed on the same backend
+// FNV-1a hash of the graph structure (node/leaf pointers + counts). Stable
+// across computes when the same tensor objects form the same topology, so the
+// RPC backend can reuse its serialized graph instead of re-sending the full
+// graph on every token. CUDA/CPU splits keep the default unique uid because
+// their graph caches also validate shape/data properties and a structure-only
+// hash could alias different shapes.
+static uint64_t ggml_graph_structure_hash(const struct ggml_cgraph * graph) {
+    uint64_t h = 14695981039346656037ULL;
+    auto mix = [&h](uint64_t v) {
+        h ^= v;
+        h *= 1099511628211ULL;
+    };
+    mix((uint64_t) graph->n_nodes);
+    mix((uint64_t) graph->n_leafs);
+    for (int i = 0; i < graph->n_nodes; i++) {
+        mix((uint64_t) (uintptr_t) graph->nodes[i]);
+    }
+    for (int i = 0; i < graph->n_leafs; i++) {
+        mix((uint64_t) (uintptr_t) graph->leafs[i]);
+    }
+    return h;
+}
+
