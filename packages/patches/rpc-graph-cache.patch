-    // set ids for all splits
+    // set ids for all splits: derive the uid from the graph structure so that
+    // backends (RPC, CUDA) can cache the split graph across identical computes
+    // (e.g. the per-token decode loop) instead of re-serializing or
+    // re-validating the full graph every time. A changed structure yields a
+    // different uid, so stale caches can never be reused.
     for (int i = 0; i < sched->n_splits; ++i) {
-        sched->splits[i].graph.uid = ggml_graph_next_uid();
+        sched->splits[i].graph.uid = ggml_graph_structure_hash(&sched->splits[i].graph);
     }
