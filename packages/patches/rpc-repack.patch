+// Pick the buffer type for a device. For CPU devices prefer the repack
+// buffer type (when available) so quantized weights (mxfp4, q4_0, ...) get
+// repacked into the interleaved layouts used by the fast GEMV kernels.
+// Without this, RPC-served weights always take the slower plain vec_dot path.
+static ggml_backend_buffer_type_t rpc_server_get_buft(ggml_backend_dev_t dev) {
+    ggml_backend_buffer_type_t buft = ggml_backend_get_default_buffer_type(dev);
+    if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+        static ggml_backend_buffer_type_t repack_buft = nullptr;
+        if (repack_buft == nullptr) {
+            auto * reg = ggml_backend_dev_backend_reg(dev);
+            if (reg != nullptr) {
+                repack_buft = (ggml_backend_buffer_type_t) ggml_backend_reg_get_proc_address(
+                    reg, "ggml_backend_cpu_repack_buffer_type");
+            }
+        }
+        if (repack_buft != nullptr) {
+            buft = repack_buft;
+        }
+    }
+    return buft;
+}
