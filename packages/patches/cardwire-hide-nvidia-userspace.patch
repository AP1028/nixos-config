+/// Driver metadata files that advertise a vendor to user space: Vulkan ICD
+/// manifests, libglvnd EGL/GLX vendor manifests, Vulkan implicit layers and
+/// OpenCL vendor files.
+///
+/// Blocking the device nodes is not enough on its own — a blocked process can
+/// still read these manifests, load the vendor driver, and then watch it fail
+/// to open the denied device. Consumers that treat that failure as fatal
+/// instead of falling back (CEF/ANGLE/SwANGLE: "Initialization of all EGL
+/// display types failed", GPU process crash loop, GPU acceleration disabled)
+/// start slowly and render in software because of it. Put in the *per-process*
+/// map, these inodes make the vendor look absent to non-allowed processes —
+/// ENOENT for reads and hidden from directory listings — while allowed
+/// processes keep full access.
+///
+/// Contrast `exp_nvidia_inodes()`, which the experimental global NVIDIA block
+/// uses: that map is global, so it also hides the vendor from allowed
+/// processes (which is why it breaks CUDA for them).
+pub fn vendor_meta_inodes() -> Result<Vec<InodeKey>> {
+    // (directory, files in it that belong to the vendor)
+    const VENDOR_MANIFESTS: &[(&str, &[&str])] = &[
+        // NixOS: the driver tree referenced by hardware.graphics
+        (
+            "/run/opengl-driver/share/vulkan/icd.d",
+            &["nvidia_icd.json", "nvidia_icd.x86_64.json"],
+        ),
+        (
+            "/run/opengl-driver-32/share/vulkan/icd.d",
+            &["nvidia_icd.json", "nvidia_icd.i686.json"],
+        ),
+        (
+            "/run/opengl-driver/share/vulkan/implicit_layer.d",
+            &["nvidia_layers.json"],
+        ),
+        (
+            "/run/opengl-driver/share/glvnd/egl_vendor.d",
+            &["10_nvidia.json"],
+        ),
+        (
+            "/run/opengl-driver-32/share/glvnd/egl_vendor.d",
+            &["10_nvidia.json"],
+        ),
+        ("/run/opengl-driver/etc/OpenCL/vendors", &["nvidia.icd"]),
+        // Standard Linux layouts
+        (
+            "/etc/vulkan/icd.d",
+            &[
+                "nvidia_icd.json",
+                "nvidia_icd.x86_64.json",
+                "nvidia_icd.i686.json",
+            ],
+        ),
+        (
+            "/usr/share/vulkan/icd.d",
+            &[
+                "nvidia_icd.json",
+                "nvidia_icd.x86_64.json",
+                "nvidia_icd.i686.json",
+            ],
+        ),
+        (
+            "/usr/share/vulkan/implicit_layer.d",
+            &["nvidia_layers.json"],
+        ),
+        ("/usr/share/glvnd/egl_vendor.d", &["10_nvidia.json"]),
+        ("/etc/OpenCL/vendors", &["nvidia.icd"]),
+    ];
+
+    let mut inodes: Vec<InodeKey> = Vec::new();
+
+    for (dir, names) in VENDOR_MANIFESTS {
+        let Ok(entries) = fs::read_dir(dir) else {
+            continue;
+        };
+
+        for entry in entries.flatten() {
+            let entry_name = entry.file_name();
+            let Some(name) = entry_name.to_str() else {
+                continue;
+            };
+
+            if !names.contains(&name) {
+                continue;
+            }
+
+            let Ok(metadata) = fs::metadata(entry.path()) else {
+                continue;
+            };
+
+            if metadata.is_file() {
+                inodes.push(InodeKey::new(name, metadata.ino()));
+            }
+        }
+    }
+
+    Ok(inodes)
+}
+
+/// The vendor's user-space driver libraries: libGLX_nvidia, libEGL_nvidia,
+/// libGLESv*_nvidia, libnvidia-*, libcuda, libnvcuvid, libnvoptix, ...
+///
+/// This closes the last hole in `vendor_meta_inodes`. A launcher — or a desktop
+/// environment with a stale Switcheroo cache — can put
+/// `__GLX_VENDOR_LIBRARY_NAME=nvidia` / `VK_LOADER_DRIVERS_SELECT=*nvidia*` into
+/// a process's environment, and libglvnd then dlopens the driver *directly*,
+/// never reading the manifests that are hidden from blocked processes. Measured
+/// 2026-09-26: a blocked Steam client launched with those variables mapped 34
+/// NVIDIA libraries, then died with "X Error of failed request: BadValue" and a
+/// segfault when the driver could not reach the denied device, while the same
+/// client launched without them was fine.
+///
+/// Hiding the library files makes an injected vendor variable inert: libglvnd
+/// finds no NVIDIA vendor at all and falls back to Mesa, which is exactly what
+/// "this process has no discrete GPU" should look like to the application.
+/// Allowed processes still see everything, so games, CUDA and nvidia-offload are
+/// unaffected.
+pub fn vendor_library_inodes() -> Result<Vec<InodeKey>> {
+    const VENDOR_LIB_DIRS: &[&str] = &["/run/opengl-driver/lib", "/run/opengl-driver-32/lib"];
+
+    fn is_vendor_library(name: &str) -> bool {
+        let name = name.to_ascii_lowercase();
+        name.contains("nvidia")
+            || name.starts_with("libcuda")
+            || name.starts_with("libnvcuvid")
+            || name.starts_with("libnvoptix")
+    }
+
+    let mut inodes: Vec<InodeKey> = Vec::new();
+
+    for lib_dir in VENDOR_LIB_DIRS {
+        let Ok(entries) = fs::read_dir(lib_dir) else {
+            continue;
+        };
+
+        for entry in entries.flatten() {
+            let path = entry.path();
+            let Some(name) = path.file_name().and_then(|name| name.to_str()) else {
+                continue;
+            };
+
+            if !is_vendor_library(name) {
+                continue;
+            }
+
+            // fs::metadata follows symlinks: the inode recorded is the real
+            // library in the driver store path, which is what an open() resolves
+            // to, while `name` keeps the alias the process asks for (libcuda.so,
+            // libcuda.so.1, ... are different names for the same inode).
+            let Ok(metadata) = fs::metadata(&path) else {
+                continue;
+            };
+
+            if metadata.is_file() {
+                inodes.push(InodeKey::new(name, metadata.ino()));
+            }
+        }
     }
 
     Ok(inodes)
