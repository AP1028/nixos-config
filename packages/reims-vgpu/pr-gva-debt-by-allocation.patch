+    /// The newest armed debt whose window starts exactly at `gva`, under **any**
+    /// resource, when its geometry matches.
+    ///
+    /// One guest allocation can be described by two task-local texture objects:
+    /// a render thread renders into its own reference while another task's
+    /// object samples the same storage, and `GvaPlaneKey` — deliberately, for
+    /// ordinary lifetime reasons — keys the ledger by `(task, reference)`. A
+    /// sampled bind arriving under the other name can then find no generation
+    /// even though the resident holding the frame is exactly the image it
+    /// wants. This answers that lookup by allocation instead of by name. The
+    /// caller is responsible for checking that the resident it names is ready
+    /// (`resident_content_ready`), which is where readiness and reclaim live.
+    pub(crate) fn gva_debt_at(&self, gva: u64, width: u32, height: u32) -> Option<GvaWritebackDebt> {
+        self.gva_debts
+            .values()
+            .filter(|debt| debt.gva == gva && debt.width == width && debt.height == height)
+            .max_by_key(|debt| debt.seq)
+            .copied()
+    }
+
