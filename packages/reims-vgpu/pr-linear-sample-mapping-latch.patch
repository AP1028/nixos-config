+/// Latch `(task, ref) -> mapping` for a linear sample whose bytes are a guest
+/// surface, so a writeback debt armed by mapping can be paid by the ref a
+/// sample names.
+///
+/// Conservative by construction: the first physical page of the buffer must
+/// appear in a mapping's page list, and exactly one mapping may claim it. A
+/// miss or an ambiguity latches nothing, which is the behaviour this rail had
+/// before the latch existed.
+fn latch_linear_sample_mapping(
+    latch: &mut std::collections::BTreeMap<(u32, u32), u32>,
+    mappings: &std::collections::BTreeMap<u32, crate::model::MappingEntry>,
+    task_id: u32,
+    texture_ref: u32,
+    first_page: Option<u64>,
+) {
+    let Some(first_page) = first_page else {
+        return;
+    };
+    let mut found: Option<u32> = None;
+    for (&mid, mapping) in mappings.iter() {
+        if mapping
+            .page_entries
+            .iter()
+            .any(|&page| u64::from(page) == first_page)
+        {
+            if found.is_some() {
+                return;
+            }
+            found = Some(mid);
+        }
+    }
+    if let Some(mid) = found {
+        if latch.insert((task_id, texture_ref), mid).is_none() {
+            crate::runtime::drain::note_store_route("linear_sample_mapping_latched");
+        }
+    }
+}
+
