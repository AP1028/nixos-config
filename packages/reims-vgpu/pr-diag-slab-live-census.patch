+/// DIAGNOSTIC (temporary): what the image slab's live population is made of,
+/// beside the blocks it is holding.
+///
+/// `registry_pressure`'s `slab_mib=carved/held` says 27 GiB of 30 GiB is
+/// occupied and cannot say by what, nor whether the 3 GiB difference is spares
+/// or slivers. This is the line that can: `count`/`mib` are the live
+/// sub-allocations, the buckets are their sizes (`lt1/lt4/lt16/lt64/lt256/ge256`
+/// MiB, each `count/mib`), and `empty`/`partial` split the blocks the driver has
+/// given this device into those holding nothing (reclaimable outright) and those
+/// with free space no large image fits in (fragmentation).
+fn emit_slab_live(now: &crate::backend::vulkan::engine::CounterSnapshot) {
+    use std::fmt::Write as _;
+    let buckets = [
+        ("lt1", now.slab_live_lt1_count, now.slab_live_lt1_bytes),
+        ("lt4", now.slab_live_lt4_count, now.slab_live_lt4_bytes),
+        ("lt16", now.slab_live_lt16_count, now.slab_live_lt16_bytes),
+        ("lt64", now.slab_live_lt64_count, now.slab_live_lt64_bytes),
+        ("lt256", now.slab_live_lt256_count, now.slab_live_lt256_bytes),
+        ("ge256", now.slab_live_ge256_count, now.slab_live_ge256_bytes),
+    ];
+    let mut rendered = String::new();
+    for (i, (name, count, bytes)) in buckets.iter().enumerate() {
+        if i > 0 {
+            rendered.push(',');
+        }
+        let _ = write!(rendered, "{name}:{count}/{}mib", bytes >> 20);
+    }
+    crate::observe::off(format!(
+        "slab_live count={} mib={} carved={}mib held={}mib buckets={rendered} \
+         empty={}/{}mib partial={}/{}mib",
+        now.slab_live_count,
+        now.slab_live_bytes >> 20,
+        // Beside the live population, because the two figures answer different
+        // questions and a reader has to be able to see them disagree: `live` is
+        // what this census walked, `carved` is what the blocks say is occupied
+        // (including per-carve alignment padding, which no token accounts for).
+        // Printing `live` alone invites reading it as the whole population.
+        now.slab_carved_bytes >> 20,
+        now.slab_held_bytes >> 20,
+        now.slab_empty_blocks,
+        now.slab_empty_bytes >> 20,
+        now.slab_partial_blocks,
+        now.slab_partial_free_bytes >> 20,
+    ));
+}
