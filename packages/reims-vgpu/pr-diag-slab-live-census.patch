+    /// What the live population and the retained blocks are actually made of.
+    ///
+    /// DIAGNOSTIC (temporary): read by the `slab_live` census line.
+    ///
+    /// `held_bytes` says what the driver has given this device and `carved` how
+    /// much of it images occupy, and the difference has two readings that mean
+    /// opposite things for an allocation that just failed: a couple of empty
+    /// blocks kept as spares (`SLAB_KEEP_EMPTY`), which is nothing to reclaim,
+    /// or thousands of slivers no 8 MiB image fits in, which is fragmentation
+    /// wearing the same number. Nor does either figure say what the carved side
+    /// is made of — three thousand multi-MiB images and thirty thousand small
+    /// ones hold the same bytes and need different answers.
+    ///
+    /// The buckets are by size, in MiB, first bucket under one: `[<1, <4, <16,
+    /// <64, <256, >=256]`. A driven title's 1920x1080 colour targets land in
+    /// `<16`, so a dominant `<16` bucket with a count in the thousands is the
+    /// render-target population and not the sampled-cache textures.
+    pub(crate) fn live_census(&self) -> SlabLiveCensus {
+        let mut census = SlabLiveCensus::default();
+        for token in self.live.values() {
+            census.live_count += 1;
+            census.live_bytes = census.live_bytes.saturating_add(token.size);
+            let mib = token.size >> 20;
+            let bucket = SLAB_LIVE_BUCKET_LIMIT_MIB
+                .iter()
+                .position(|limit| mib < *limit)
+                .unwrap_or(SLAB_LIVE_BUCKETS - 1);
+            census.bucket_count[bucket] += 1;
+            census.bucket_bytes[bucket] = census.bucket_bytes[bucket].saturating_add(token.size);
+        }
+        for b in self.blocks.iter().flatten() {
+            let size = b.plan.size();
+            let free = b.plan.free_bytes();
+            if free == size {
+                census.empty_blocks += 1;
+                census.empty_bytes = census.empty_bytes.saturating_add(size);
+            } else if free > 0 {
+                census.partial_blocks += 1;
+                census.partial_free_bytes = census.partial_free_bytes.saturating_add(free);
+            }
+        }
+        census
+    }
