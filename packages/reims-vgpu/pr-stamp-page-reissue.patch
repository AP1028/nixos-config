+/// Drop the outstanding stamp points whose page has caught up, and keep the
+/// rest for the publication point to re-attach.
+///
+/// Detection only: a re-issue from here would have no submission to ride, and
+/// the `Queued` rail lands a word only when it rides one — the first form of
+/// this repair left the backlog standing for exactly that reason. The
+/// re-attachment lives in [`reissue_pending_stamps`], called where a
+/// submission exists.
+fn settle_pending_stamp_pages<H: HostMemory + HostOps>(state: &mut DeviceState, host: &mut H) {
+    if state.pending_stamp_page_writes.is_empty() || state.gfx.fifo_base_page == 0 {
+        return;
+    }
+    let pending = std::mem::take(&mut state.pending_stamp_page_writes);
+    for (index, value) in pending {
+        let Some(off) = stamp_slot_offset(index, state.page_size()) else {
+            continue;
+        };
+        let gpa = state.pfn_gpa(state.gfx.fifo_base_page) + off;
+        let Ok(current) = crate::runtime::host::read_u32(host, gpa) else {
+            state.pending_stamp_page_writes.insert(index, value);
+            continue;
+        };
+        // A page at or past the point means the ordered write landed (or a
+        // later one did): nothing left to attach.
+        if (current.wrapping_sub(value) as i32) >= 0 {
+            continue;
+        }
+        // A point the plane no longer holds is not one the guest is owed.
+        let held = state
+            .published_completion_stamp(reims_vgpu_core::identity::StampSlot(index))
+            .is_some_and(|published| {
+                reims_vgpu_core::identity::StampWait {
+                    slot: reims_vgpu_core::identity::StampSlot(index),
+                    value: reims_vgpu_core::identity::StampValue(value),
+                }
+                .satisfied_by(published)
+            });
+        if held {
+            state.pending_stamp_page_writes.insert(index, value);
+        }
+    }
+}
