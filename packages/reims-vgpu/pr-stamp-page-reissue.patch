+/// Re-attach the outstanding stamp points to the submission being queued.
+///
+/// Called from the publication point, immediately before the word being
+/// published takes the same rail, so a submission is in flight and every
+/// re-attached word is ordered after **this** work — later than the work it
+/// completes, which is what keeps the guest's fence from firing early. The
+/// slot being published is skipped: its new value supersedes the outstanding
+/// one, and re-attaching the older value after the newer would move the page
+/// backwards.
+fn reissue_pending_stamps<H: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut H,
+    current_index: u32,
+) {
+    if state.pending_stamp_page_writes.is_empty() {
+        return;
+    }
+    let pending = std::mem::take(&mut state.pending_stamp_page_writes);
+    for (index, value) in pending {
+        if index == current_index {
+            // Superseded by the publication in flight.
+            continue;
+        }
+        if crate::backend::selected().order_completion_stamp(
+            state,
+            host,
+            index,
+            value,
+            crate::runtime::render_writeback::SettleSite::CompletionStamp,
+        ) == crate::backend::StampOrdering::Queued
+        {
+            note_store_route("stamp_page_reissued");
+            state.pending_stamp_page_writes.insert(index, value);
+        }
+        // A non-`Queued` answer means the rail ordered it inline or wrote the
+        // page itself, so the point is no longer outstanding.
+    }
+}
