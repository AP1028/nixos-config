+/// Whether a decoded Metal pixel format is one of the depth formats.
+///
+/// Named here because the sampled rails must tell a depth texture (whose bytes
+/// exist only in a device resident — no CPU loader, no sampled layout) from a
+/// colour one without asking the layout table, which has no answer for these.
+pub(super) fn is_depth_pixel_format(format: u16) -> bool {
+    use crate::protocol::pixel_format as p;
+    matches!(
+        format,
+        p::MTL_FORMAT_DEPTH16_UNORM
+            | p::MTL_FORMAT_DEPTH32_FLOAT
+            | p::MTL_FORMAT_DEPTH24_UNORM_STENCIL8
+            | p::MTL_FORMAT_DEPTH32_FLOAT_STENCIL8
+    )
+}
