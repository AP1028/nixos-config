+    /// Whether the live multisample scratch is the one `key` describes.
+    ///
+    /// One predicate for two questions, so they cannot drift: [`Self::
+    /// acquire_multisample_target`] reuses the slot exactly when this answers
+    /// true, and `execute_draw_request` asks it *before* the acquisition to
+    /// decide whether a pass that declared `Preserve` can honour that. A fresh
+    /// image has no prior content, so a preserving pass over one must begin with
+    /// a clear rather than load an image created `UNDEFINED`.
+    pub(crate) fn multisample_slot_is_live(&self, key: &MultisampleTargetKey) -> bool {
+        self.multisample_target
+            .as_ref()
+            .is_some_and(|slot| slot.key == *key && !key.transient_depth)
+    }
+
