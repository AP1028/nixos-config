diff --git a/crates/reims-vgpu/src/runtime/writeback_debt.rs b/crates/reims-vgpu/src/runtime/writeback_debt.rs
--- a/crates/reims-vgpu/src/runtime/writeback_debt.rs
+++ b/crates/reims-vgpu/src/runtime/writeback_debt.rs
@@ -750,6 +750,24 @@
         return;
     }
     let Some(debt) = state.pending_writebacks.take(mapping_id) else {
+        // A mapping that owes nothing may still be the *same guest allocation*
+        // a GVA-keyed debt covers: `arm_gva` keys those by `(task, ref)`, and
+        // the mapping this reader named is not in that key at all, so a
+        // mapping-keyed lookup cannot see them. That is the "cannot name the
+        // mapping it is about to read" case `pay_all` exists for — aliasing
+        // across the id namespaces is real, so "cannot say" resolves to "owes
+        // all of them". This is the reader side of the split the GVA
+        // writeback-debt arm fixes on the writer side.
+        //
+        // Only when a GVA debt actually exists, so the empty-ledger and
+        // mapping-only cases keep their one-lookup cost. Counted, because it
+        // settles work this reader did not name and the census is what says
+        // whether the alias is real.
+        let gva_owed = !state.pending_writebacks.gva_debts.is_empty();
+        if gva_owed {
+            crate::runtime::drain::note_store_route("wbdebt_mapping_pays_gva_alias");
+            pay_all(state, host);
+        }
         return;
     };
     pay(state, host, mapping_id, debt, "wbdebt_paid_named");
