+    /// Wait and retire **only** the entry the caller just submitted.
+    ///
+    /// The CPU-visible compute path used [`Self::retire_all`] here — a full
+    /// device quiesce — to make its readback safe, and that is the wrong shape
+    /// for a fence whose subject is one submission. A driven Easy Red 2 session
+    /// is the reading: the game's blend-shape and skinning dispatches each
+    /// carry a CPU-visible output, so every one of them took the quiesce, and
+    /// the packet-processing thread sat in `retire_all`/`release_graveyard` for
+    /// minutes at a time — waiting fences it did not need and sweeping a
+    /// graveyard that was not its subject — with the guest's packets queued
+    /// behind it. The guest's Metal resource deletes then blocked in the kernel
+    /// waiting for a device that was busy waiting, Unity's render thread
+    /// blocked behind those, and the screen stayed black.
+    ///
+    /// The wait the readback needs is this entry's own fence, and nothing the
+    /// sweep was doing is lost: `advance_graveyard_maintenance` runs the same
+    /// retire on the poll heartbeat without waiting, and every `begin_entry`
+    /// retires already-signaled slots.
+    pub(crate) unsafe fn retire_compute_entry(
+        &mut self,
+        ctx: &DeviceContext,
+        counters: &EngineCounters,
+    ) -> Result<(), DrawError> {
+        // The entry may still be inside the open tail batch, in which case
+        // there is no fence of its own to wait yet.
+        unsafe { self.batch_flush(ctx, counters)? };
+        let index = self.cur;
+        unsafe { self.retire_slot(ctx, counters, index) }
+    }
+
     /// Free/recycle the resources owed by a retired entry.
     ///
     /// # Safety
