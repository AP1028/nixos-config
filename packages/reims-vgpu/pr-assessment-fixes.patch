+
+/// Put a stamp point in its guest page and report it visible.
+///
+/// The tail both the publication path and the re-issue path owe a non-`Queued`
+/// answer: [`crate::backend::StampOrdering::Settled`] means *the caller writes
+/// the word* and that everything owed guest RAM has already landed, so an inline
+/// write here cannot outrun the work the point completes. Shared rather than
+/// duplicated because the re-issue path used to read the same answer as "the
+/// rail ordered it inline" and drop the point without writing anything, which
+/// left the page behind the ordering plane's point — a guest fence that never
+/// lands, in exactly the superseded case the re-issue exists for.
+fn land_stamp_page<H: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut H,
+    index: u32,
+    stamp_value: u32,
+    gpa: u64,
+    page_size: usize,
+    site: &'static str,
+) {
+    if gpa_map::write_u32(host, gpa, stamp_value, page_size).is_err() {
+        return;
     }
+    // The word is in the page: from here the guest can read it, which is
+    // the event the ordering plane's stamp waits are about.
+    note_stamp_visible(state, index, stamp_value, site);
+    // The guest's fence has moved. Everything it allocated for the work this
+    // stamp completes may be freed from here on, which is why a Store's
+    // guest-page write has to have landed before the stamp rather than
+    // after — see `runtime::render_writeback`.
+    state.completion_stamp_seq = state.completion_stamp_seq.wrapping_add(1);
+    state
+        .gfx
+        .interrupt_status_gpu
+        .fetch_or(1u32 << (index & 0x1f), std::sync::atomic::Ordering::AcqRel);
+    host.enqueue(HostAction::irq_gfx());
 }
 
