+
+/// A block-compressed mip tail is one whole block, so a copy that names it fits.
+///
+/// The guest's `MTLSize` for a compressed texture is in blocks, and every level
+/// below the block side still occupies exactly one — the refusal this covers
+/// (`t2t_extent_oob`, `requested=4 available=2`) lost ~1 000 copies a boot on a
+/// driven Unity title, one per level from the block side down to the tail.
+#[test]
+fn a_compressed_mip_tail_offers_a_whole_block() {
+    // A 2x2 BC1 level (4x4, 8-byte blocks): the tail of a 1024-wide chain.
+    assert_eq!(copy_available_extent(2, 4), 4);
+    assert_eq!(copy_available_extent(1, 4), 4);
+    assert_eq!(copy_available_extent(3, 4), 4);
+    // Whole blocks round up, never down: a 7-texel level holds two block columns.
+    assert_eq!(copy_available_extent(7, 4), 8);
+    assert_eq!(copy_available_extent(8, 4), 8);
+    // An uncompressed axis is unchanged, and an empty axis offers nothing.
+    assert_eq!(copy_available_extent(8, 1), 8);
+    assert_eq!(copy_available_extent(0, 4), 0);
+    assert_eq!(copy_available_extent(0, 1), 0);
+}
