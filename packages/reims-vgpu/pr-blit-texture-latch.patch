+/// The last backing each `(task, ref, level, slice)` resolved to, so a publish
+/// race can be answered instead of failing the blit.
+///
+/// The miss this exists for is [`crate::runtime::objects::slot_recheck`]'s: the
+/// guest deletes and re-creates an object and the packet names the ref before
+/// the new slot is published. For a blit that is not a lost draw but a lost
+/// *upload* — the game's textures never reach the device, every draw that
+/// samples them comes out black, and the window is a black rectangle with
+/// music over it while the desktop (whose textures resolved cleanly) renders.
+/// A frame late is the answer; absent is not.
+///
+/// Served only while the slot-recheck watch is young
+/// ([`crate::runtime::objects::slot_recheck::pending_publication`]), so a
+/// deleted object's layout cannot be served past the window the publish race
+/// lives in.
+static BLIT_TEXTURE_LATCH: std::sync::LazyLock<
+    std::sync::Mutex<
+        std::collections::HashMap<(u32, u32, u16, u16), TextureBacking>,
+    >,
+> = std::sync::LazyLock::new(|| std::sync::Mutex::new(std::collections::HashMap::new()));
+
+/// Bound on the latch's population: a task that churns refs must not grow it
+/// without limit. Past this, only keys already in the table are refreshed.
+const BLIT_TEXTURE_LATCH_CAP: usize = 8192;
+
+fn latch_blit_texture(
+    task_id: u32,
+    texture_ref: u32,
+    level: u16,
+    slice: u16,
+    backing: &TextureBacking,
+) {
+    let mut latch = BLIT_TEXTURE_LATCH
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    let key = (task_id, texture_ref, level, slice);
+    if latch.len() >= BLIT_TEXTURE_LATCH_CAP && !latch.contains_key(&key) {
+        return;
+    }
+    latch.insert(key, backing.clone());
+}
+
+fn latched_blit_texture(
+    task_id: u32,
+    texture_ref: u32,
+    level: u16,
+    slice: u16,
+) -> Option<TextureBacking> {
+    BLIT_TEXTURE_LATCH
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+        .get(&(task_id, texture_ref, level, slice))
+        .cloned()
+}
