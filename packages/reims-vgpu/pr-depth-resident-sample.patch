+/// The sampled bind of a texture this device rendered **depth** into.
+///
+/// A depth attachment is the one target kind the engine keys by the guest's
+/// **texture reference** rather than by a GVA: [`depth_chain_identity`] builds
+/// [`TargetIdentity::Texture`] because the depth resource lives as long as the
+/// guest texture does, and its resident is the only copy of what the pass
+/// rendered (no CPU loader and no writeback rail moves a depth attachment's
+/// texels). A later pass that samples that texture — every `[[depth]]`-based
+/// effect, so a driven Unity scene's post chain — names the same resource, so
+/// the same identity is the answer; but the GVA rails cannot construct it.
+/// Their witness has no entry for a span no Store ever published, so
+/// [`try_gva_resident_sample`] declines with `gvaw_no_entry`, the linear rails
+/// then decline for want of a sampled layout, and the draw is refused.
+///
+/// This asks the registry for the texture-keyed resident directly. Only the
+/// formats a depth attachment can carry are considered, because that is the
+/// only resident kind the engine registers under a texture reference — a colour
+/// target's resident is GVA-keyed and reached by [`try_gva_resident_sample`] —
+/// so a ref reuse that now names a colour texture cannot bind an old depth
+/// image. The stencil bit is the pass's *state*, not the format's: a
+/// `Depth32Float_Stencil8` texture rendered without a stencil test has a
+/// depth-only resident, so both spellings are asked with the format's own
+/// aspect first.
+#[must_use]
+pub(super) fn try_texture_resident_sample(
+    texture_ref: u32,
+    tex: &TextureDescriptor,
+) -> Option<(u32, u32, SampledSourceRequest)> {
+    use crate::backend::vulkan::engine::{resident_content_ready, TargetIdentity};
+    use crate::protocol::pixel_format as p;
+
+    if !matches!(
+        tex.pixel_format,
+        p::MTL_FORMAT_DEPTH16_UNORM
+            | p::MTL_FORMAT_DEPTH32_FLOAT
+            | p::MTL_FORMAT_DEPTH24_UNORM_STENCIL8
+            | p::MTL_FORMAT_DEPTH32_FLOAT_STENCIL8
+    ) {
+        return None;
+    }
+    let declared = tex.declared_pixel_format()?;
+    let format = translate::pixel::translate(declared).ok()?.vk;
+    let (w, h) = tex.extent()?;
+    let carries_stencil = matches!(
+        declared,
+        p::MTL_FORMAT_DEPTH24_UNORM_STENCIL8 | p::MTL_FORMAT_DEPTH32_FLOAT_STENCIL8
+    );
+    let aspects = if carries_stencil { [true, false] } else { [false, true] };
+    for stencil in aspects {
+        let identity = TargetIdentity::Texture {
+            ref_: texture_ref,
+            width: w,
+            height: h,
+            generation: 0,
+            stencil,
+        };
+        let ready = resident_content_ready(&identity);
+        if ready {
+            crate::runtime::drain::note_store_route("depth_resident_sample");
+            return Some((w, h, SampledSourceRequest::Target(identity, format)));
+        }
+    }
+    None
+}
