+/// Whether a Vulkan format carries a depth aspect.
+///
+/// Asked by the sampled-view rule above, because a depth image's view must
+/// carry the image's own format and aspects, and by any rail that needs to
+/// tell a depth attachment from a colour one. Total over the formats this
+/// vocabulary can name; a caller holding an image asks about the image's own
+/// format rather than a list of the formats a particular rail creates.
+pub fn format_is_depth(format: vk::Format) -> bool {
+    matches!(
+        format,
+        vk::Format::D16_UNORM
+            | vk::Format::X8_D24_UNORM_PACK32
+            | vk::Format::D32_SFLOAT
+            | vk::Format::D16_UNORM_S8_UINT
+            | vk::Format::D24_UNORM_S8_UINT
+            | vk::Format::D32_SFLOAT_S8_UINT
+    )
+}
