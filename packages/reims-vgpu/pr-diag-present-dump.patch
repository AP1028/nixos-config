+    /// Write the resident behind a published frame as a P6 PPM, at most a few times.
+///
+/// DIAGNOSTIC (temporary): `REIMS_VGPU_PRESENT_DUMP=<dir>` names the directory.
+/// The read goes through the engine's own `read_resident_bgra`, which is the
+/// same resident the present takes, so a black file here is the device's frame
+/// being black and not the window's blit failing. Bounded to a handful of dumps
+/// so one boot cannot fill the disk, and every attempt is logged with the
+/// identity it read and the RGB census of the pixels.
+#[cfg(feature = "backend-vulkan")]
+fn dump_present_resident(resident: Option<&crate::backend::window::WindowResident>) {
+    use std::sync::atomic::{AtomicU32, Ordering};
+    // Sampled across the boot, not the first N: the first presents of a boot are
+    // the pre-paint black frames, and what needs looking at is the frame the
+    // window shows once the guest has content (a game menu, a black window).
+    static CALLS: AtomicU32 = AtomicU32::new(0);
+    static DUMPS: AtomicU32 = AtomicU32::new(0);
+    let call = CALLS.fetch_add(1, Ordering::Relaxed);
+    // Every 256th present, not every 32nd: a boot reaches its first interesting
+    // transition ~1000 presents in, so a fine-grained cap spends all forty
+    // dumps on the pre-paint frames and has none left for the launch it was
+    // meant to catch. 256 × 40 covers ten thousand presents, which is a whole
+    // session's worth of frames at forty files.
+    if call % 256 != 0 || DUMPS.load(Ordering::Relaxed) >= 40 {
+        return;
+    }
+    let Some(crate::backend::window::WindowResident::Vulkan(src)) = resident else {
+        return;
+    };
+    let (w, h) = (src.width, src.height);
+    let need = (w as usize).saturating_mul(h as usize).saturating_mul(4);
+    if need == 0 {
+        return;
+    }
+    let Ok(dir) = std::env::var("REIMS_VGPU_PRESENT_DUMP") else {
+        return;
+    };
+    let Some(bgra) = crate::backend::vulkan::engine::read_resident_bgra(&src.identity, need) else {
+        crate::observe::off(format!(
+            "present_dump skip identity={:?} {w}x{h} (no readable resident)",
+            src.identity
+        ));
+        return;
+    };
+    let n = DUMPS.fetch_add(1, Ordering::Relaxed);
+    let (rgb_nz, max_rgb, px0) = crate::observe::bgra_rgb_stats(&bgra);
+    let path = format!("{dir}/present-dump-{n}.ppm");
+    let mut out = Vec::with_capacity(need / 4 * 3 + 32);
+    out.extend_from_slice(format!("P6\n{w} {h}\n255\n").as_bytes());
+    for px in bgra.chunks_exact(4) {
+        out.extend_from_slice(&[px[2], px[1], px[0]]);
+    }
+    match std::fs::write(&path, &out) {
+        Ok(()) => crate::observe::off(format!(
+            "present_dump wrote={path} identity={:?} {w}x{h} rgb_nz={rgb_nz} max_rgb={max_rgb} \
+             px0=[{},{},{},{}]",
+            src.identity, px0[0], px0[1], px0[2], px0[3]
+        )),
+        Err(error) => crate::observe::off(format!("present_dump fail={error} path={path}")),
+    }
+}
