+/// A fragment that declares `[[front_facing]]` as an `int` — Unity's HLSL
+/// lowers some boolean uses to `i32` — and reads it in its body, so a lowering
+/// that refused the parameter or spliced a raw bool where an int is used fails
+/// on the emitted arithmetic and not only on the declarations.
+const FRAGMENT_WITH_INT_FRONT_FACING: &str = r#"target triple = "air64_v28-apple-macosx26.5.0"
