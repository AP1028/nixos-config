+!0 = !{ptr @frag, !1, !2ATTR}
+!1 = !{!3}
+!3 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"float4"}
+!2 = !{!4}
+!4 = !{i32 0, !"air.front_facing", !"air.arg_type_name", !"int", !"air.arg_name", !"ff"}
+"#;
