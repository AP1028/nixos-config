+
+/// `[[front_facing]]` is a boolean builtin, but a shader may declare the
+/// parameter as an integer (Unity's HLSL does for some uses) and its body then
+/// does integer arithmetic with it. The builtin is loaded as the bool it is and
+/// selected into the parameter's own type, so the body sees a value and not a
+/// zero that would claim every triangle is back-facing.
+#[test]
+fn front_facing_declared_as_an_integer_selects_the_builtin() {
+    let asm = translate(FRAGMENT_WITH_INT_FRONT_FACING, "", Stage::Fragment)
+        .expect("a fragment declaring an integer front_facing translates");
+    assert!(
+        asm.contains("BuiltIn FrontFacing"),
+        "the parameter must arrive as the FrontFacing builtin:\n{asm}"
+    );
+    assert!(
+        asm.contains("OpSelect"),
+        "the loaded bool must be selected into the parameter's integer type:\n{asm}"
+    );
+}
