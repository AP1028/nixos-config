+/// Which of the three begins slot 0's pass uses, from the three questions that
+/// decide it.
+///
+/// Split out from the call site because it is the one place the three meet, and
+/// because the third is the one that must not be inferred from the other two:
+/// `offerable` is about what *this device* can hand the pass, and `stale` is
+/// about whether the image holds anything of the guest's at all. A draw whose
+/// target is a guest-named residency asks the registry (`content_ready`, the
+/// same bit that decides whether a `LOAD` is answerable); one whose target is
+/// pooled scratch passes `false`, because its cache key is the pass itself and
+/// the pass does not exist yet where this is decided.
+fn slot0_begin(offerable: bool, preserves_declared: bool, stale: bool) -> Color0Load {
+    if offerable {
+        Color0Load::Preserve
+    } else if preserves_declared && !stale {
+        Color0Load::Undefined
+    } else {
+        Color0Load::Clear
+    }
+}
+
+/// Count and name a preserving colour record whose attachment holds no contents
+/// this device can offer.
+///
+/// The draw that reaches this is the one that used to render with `DONT_CARE`:
+/// the guest asked to keep what the attachment held, the device has nothing to
+/// keep, and — for the case the fix answers — the image is freshly created, so
+/// its texels are whatever the pool last used that memory for. A driven title
+/// showed exactly that: the launch splash's rows surviving into its menu. The
+/// pass then begins with a defined clear, and this is the witness that says how
+/// often the case is real: first-sight per identity, plus an always-on counter.
+///
+/// `elected` is what the pass was actually built with, because this call site
+/// sits after `registry_ensure` and the early election sits before it. A
+/// recreated image reports no content to both, so the two agree on every case
+/// the fix answers; they can disagree only when the early answer said the guest
+/// had content and the slot then turned out fresh, which leaves `Undefined` on
+/// an unwritten image. That residual is named in the line, not absorbed.
+fn note_preserve_unhonoured(identity: &TargetIdentity, elected: Color0Load) {
+    crate::runtime::drain::note_store_route("color0_preserve_unhonoured");
+    if crate::observe::first_sight(
+        "color0_preserve_unhonoured",
+        crate::backend::hash::hash_u64(0x9e37_79b9_7f4a_7c15, identity_debug_hash(identity)),
+    ) {
+        let answer = match elected {
+            Color0Load::Clear => "a defined clear, so it cannot present the previous tenant's pixels",
+            Color0Load::Undefined => {
+                "its previous `DONT_CARE` answer, so an image recreated between the two \
+                 questions may still begin unwritten"
+            }
+            Color0Load::Preserve => "a load, which the early answer said was unanswerable",
+        };
+        crate::observe::off(format!(
+            "color0_preserve_unhonoured identity={identity:?} elected={elected:?} \
+             (the record declared a preserving load and the attachment holds no content this \
+              device can offer; the pass begins with {answer})"
+        ));
+    }
+}
+
+/// A stable number for one identity, so the first-sight latch above is per
+/// attachment rather than per process.
+fn identity_debug_hash(identity: &TargetIdentity) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    format!("{identity:?}").hash(&mut hasher);
+    hasher.finish()
+}
