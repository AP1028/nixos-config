+/// Unity sets `maxTotalThreadsPerThreadgroup` on the compute pipelines it
+/// builds, and the descriptor that carries it decodes instead of being refused
+/// for a property nobody had named.
+///
+/// Captured live from Easy Red 2 (Unity 2022.3, macOS 13.7.8 guest) on the
+/// x86/Vulkan rail: the label offset, the threadgroup ceiling, the kernel ref,
+/// then the name the label points at. Every draw that used one of these
+/// pipelines was refused before the tag was identified — 993 496
+/// `compute_load_pipeline reason=desc_decode` in one session, the game's canvas
+/// black while its audio played.
+#[test]
+fn a_compute_pipeline_that_states_its_threadgroup_ceiling_decodes() {
+    // `Internal-Skinning.main`, exactly as the guest sent it.
+    let live: [u8; 60] = [
+        0x0b, 0x00, 0x00, 0x00, 0x3c, 0x00, 0x00, 0x00, 0x31, 0x01, 0x00, 0x00, 0x2a, 0x00, 0x00,
+        0x00, 0x03, 0x02, 0x04, 0x13, 0x00, 0x00, 0x00, 0x08, 0x04, 0x40, 0x00, 0x00, 0x00, 0x00,
+        0x04, 0x76, 0x00, 0x00, 0x00, 0x49, 0x6e, 0x74, 0x65, 0x72, 0x6e, 0x61, 0x6c, 0x2d, 0x53,
+        0x6b, 0x69, 0x6e, 0x6e, 0x69, 0x6e, 0x67, 0x2e, 0x6d, 0x61, 0x69, 0x6e, 0x00, 0x00, 0x00,
+    ];
+    // The two tags this test is about are where the record says they are: the
+    // label first, then the ceiling eight bytes later.
+    assert_eq!(
+        live[SERIALIZER_OBJECT_FIRST_TLVS + 1],
+        COMPUTE_PIPELINE_TAG_LABEL
+    );
+    assert_eq!(
+        live[SERIALIZER_OBJECT_FIRST_TLVS + 7],
+        COMPUTE_PIPELINE_TAG_MAX_TOTAL_THREADS
+    );
+
+    let cap = crate::observe::FailCapture::start();
+    let cp = decode_compute_pipeline_descriptor(&live)
+        .expect("a threadgroup ceiling is a property this decoder has identified");
+    assert_eq!(cp.kernel_func_ref, 0x76);
+    assert!(
+        cp.stage_input.is_none(),
+        "the label's string is not a stage-input section"
+    );
+    let lines = cap.lines();
+    let dropped: Vec<&String> = lines
+        .iter()
+        .filter(|l| l.contains("reason=pipeline_descriptor_field_dropped"))
+        .collect();
+    assert!(
+        dropped.is_empty(),
+        "a benign tag is not a dropped field: {dropped:?}"
+    );
+}
