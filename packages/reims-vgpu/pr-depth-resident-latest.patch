+    /// The most recently ready depth resident of one geometry, with the identity
+    /// a sampled bind can name.
+    ///
+    /// A guest that ping-pongs or re-slots its camera depth renders a frame into
+    /// one texture reference and samples *another* one in the same frame — the
+    /// standard double-buffered depth shape, and Unity's. The sampled name then
+    /// finds no resident of its own even though the frame this device just
+    /// rendered is exactly the content it asked for, and the sampled bind falls
+    /// to the CPU rails, which cannot name a depth layout at all.
+    ///
+    /// This is the bridge: the newest ready depth resident at the same geometry
+    /// is the frame the sample wants. Geometry is an exact match on purpose —
+    /// depth is meaningless across shapes — and only depth formats are
+    /// considered, so this cannot serve colour content under a stale name.
+    ///
+    /// `exclude_ref` is the depth reference the *current* draw binds as its own
+    /// attachment, `0` when it binds none. A resident under that name is the
+    /// frame being rendered right now, and serving it to a sample inside the
+    /// same draw is a feedback read — the engine answers one with an
+    /// attachment snapshot, a full copy of the image per bind, which on a
+    /// driven Unity menu pinned the host GPU at 100 % and stalled the scene.
+    /// Skipping it leaves the other half of the guest's depth ping-pong, which
+    /// is the frame the sample actually asked for.
+    pub(crate) fn recent_ready_depth_resident(
+        &self,
+        width: u32,
+        height: u32,
+        exclude_ref: u32,
+    ) -> Option<TargetIdentity> {
+        self.registry
+            .iter()
+            .filter(|(identity, slot)| {
+                slot.content_ready
+                    && slot.width == width
+                    && slot.height == height
+                    && super::super::format_is_depth(slot.format.declared())
+                    && !matches!(
+                        identity,
+                        TargetIdentity::Texture { ref_, .. } if *ref_ == exclude_ref && exclude_ref != 0
+                    )
+            })
+            .max_by_key(|(_, slot)| slot.last_touch_ms)
+            .map(|(identity, _)| identity.clone())
+    }
+
     /// The generation the registry holds for the *same target* as `identity`,
     /// when the exact key is absent.
     ///
