 /// Runs at the tail of a drain tranche, with the same `state` and host the
 /// lookup used. Returns early with the lock untouched when nothing is watched,
 /// which is every tranche on every rail that does not produce the miss.
+/// Whether `(task, ref)` is a slot this device has already re-read and found
+/// empty, and the watch is young enough that the guest may still be about to
+/// publish it.
+///
+/// This is the query a caller asks when it wants to know whether a miss is the
+/// publish race the module exists for rather than a ref that is simply gone.
+/// The age bound is the whole reason it is not just "is it watched": a watch
+/// that never fills would otherwise answer yes for the rest of the task's life,
+/// and a caller that latches a resolution on that answer would serve a deleted
+/// object's bytes forever. The fill times this rail measures
+/// (`slot_recheck_fill_us` over `slot_recheck_filled`) average tens of
+/// milliseconds, so the window is a quarter second.
+pub const PUBLISH_RACE_WINDOW_US: u64 = 250_000;
+
+pub fn pending_publication(task_id: u32, ref_: u32, max_age_us: u64) -> bool {
+    let now = crate::observe::elapsed_us();
+    let ledger = ledger().lock().unwrap_or_else(|e| e.into_inner());
+    ledger
+        .watches
+        .get(&(task_id, ref_))
+        .is_some_and(|watch| now.saturating_sub(watch.recorded_us) <= max_age_us)
+}
