+/// The last resolution each `(task, texture ref)` produced, so a publish race
+/// can be answered with it instead of refusing the draw.
+///
+/// The miss this exists for is [`crate::runtime::objects::slot_recheck`]'s:
+/// the guest deletes and re-creates an object — a drawable ring recycles its
+/// refs every frame — and a packet names the ref before the new slot is
+/// published. Refusing the draw there is a black frame: the composite that
+/// samples a re-created drawable is exactly this shape, and the last
+/// resolution the ref produced is the previous frame's drawable, which is a
+/// frame late rather than absent.
+///
+/// Served only while the slot-recheck watch is young
+/// ([`crate::runtime::objects::slot_recheck::pending_publication`]), so a
+/// deleted object's bytes cannot be served past the window the publish race
+/// lives in. The entry is `(width, height, mapping, source)`, and the source
+/// is cheap to clone — every arm that carries bytes holds an `Arc`.
+static SAMPLED_RESOLUTION_LATCH: std::sync::LazyLock<
+    std::sync::Mutex<
+        std::collections::HashMap<(u32, u32), (u32, u32, u32, SampledSourceRequest)>,
+    >,
+> = std::sync::LazyLock::new(|| std::sync::Mutex::new(std::collections::HashMap::new()));
+
+/// Bound on the latch's population: a task that churns refs must not grow it
+/// without limit. Past this, only refs already in the table are refreshed.
+const SAMPLED_RESOLUTION_LATCH_CAP: usize = 4096;
+
+fn latch_sampled_resolution(
+    task_id: u32,
+    texture_ref: u32,
+    w: u32,
+    h: u32,
+    mid: u32,
+    src: &SampledSourceRequest,
+) {
+    let mut latch = SAMPLED_RESOLUTION_LATCH
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    if latch.len() >= SAMPLED_RESOLUTION_LATCH_CAP && !latch.contains_key(&(task_id, texture_ref)) {
+        return;
+    }
+    latch.insert((task_id, texture_ref), (w, h, mid, src.clone()));
+}
+
+fn latched_sampled_resolution(
+    task_id: u32,
+    texture_ref: u32,
+) -> Option<(u32, u32, u32, SampledSourceRequest)> {
+    SAMPLED_RESOLUTION_LATCH
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+        .get(&(task_id, texture_ref))
+        .cloned()
+}
