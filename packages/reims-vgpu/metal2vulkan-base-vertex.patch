 }
+
+/// `[[base_vertex]]` is the first index of an indexed draw, which Vulkan's `VertexIndex` already
+/// folds in, so it cannot be recovered from the vertex index and needs its own `BaseVertex`
+/// builtin. The builtin only exists under `SPV_KHR_shader_draw_parameters`, which therefore has to
+/// be named in a module that uses it -- and the body reads it, so a zeroed lowering would show up
+/// as a dropped `fadd` operand rather than passing on declarations alone.
+#[test]
+fn base_vertex_reaches_spirv_as_the_extension_builtin() {
+    let declaring = VERTEX_WITH_BASE.replace("PARAM", ", !5");
+    assert_ne!(declaring, VERTEX_WITH_BASE, "template has no PARAM splice point");
+    let asm = translate(&declaring, "", Stage::Vertex)
+        .expect("a vertex declaring base_vertex translates");
+
+    assert!(
+        asm.contains("OpExtension \"SPV_KHR_shader_draw_parameters\""),
+        "the BaseVertex builtin needs its extension declared:\n{asm}"
+    );
+    assert!(
+        asm.contains("BuiltIn BaseVertex"),
+        "the parameter must arrive as the BaseVertex builtin:\n{asm}"
+    );
+    // A shader that does not mention the role must not be handed the extension.
+    let plain = translate(VERTEX_WITH_BASE, "", Stage::Vertex).expect("bare vertex translates");
+    assert!(
+        !plain.contains("SPV_KHR_shader_draw_parameters"),
+        "the extension must be requested only when the role is used:\n{plain}"
+    );
+}
