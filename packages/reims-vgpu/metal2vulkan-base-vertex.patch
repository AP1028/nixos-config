 "#;
 
+/// A vertex that reads both `[[vertex_id]]` and `[[base_vertex]]` in its body, so a lowering that
+/// silently zeroed the base would change the emitted arithmetic rather than only the declarations.
+const VERTEX_WITH_BASE: &str = r#"target triple = "air64_v28-apple-macosx26.5.0"
+
+define <4 x float> @vert(i32 %vid, i32 %bv) {
+entry:
+  %f = sitofp i32 %vid to float
+  %g = sitofp i32 %bv to float
+  %s = fadd float %f, %g
+  %v0 = insertelement <4 x float> undef, float %s, i32 0
+  %v1 = insertelement <4 x float> %v0, float 0.000000e+00, i32 1
+  %v2 = insertelement <4 x float> %v1, float 0.000000e+00, i32 2
+  %v3 = insertelement <4 x float> %v2, float 1.000000e+00, i32 3
+  ret <4 x float> %v3
+}
+
+!air.vertex = !{!0}
+!0 = !{ptr @vert, !1, !3ATTR}
+!1 = !{!2}
+!2 = !{!"air.position", !"air.arg_type_name", !"float4"}
+!3 = !{!4PARAM}
+!4 = !{i32 0, !"air.vertex_id", !"air.arg_type_name", !"uint", !"air.arg_name", !"vid"}
+!5 = !{i32 1, !"air.base_vertex", !"air.arg_type_name", !"uint", !"air.arg_name", !"bv"}
+"#;
+
 /// Splice an attribute tail into a template. `attr` is the operand text plus any node definitions
 /// it needs; an empty `attr` yields the same shader with a bare root.
 fn with_attribute(template: &str, attr: &str) -> String {
@@ -338,3 +363,31 @@
