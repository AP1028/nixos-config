 /// Returns `Err` with the rejected devices' versions when nothing clears the
 /// floor, so the decline names what was found rather than reporting a bare "no
 /// Vulkan devices".
+///
+/// `names` is the `deviceName` of each candidate, in the same order, and exists
+/// for one purpose: an operator override. Two variables, because the two
+/// questions are different —
+///
+/// - `REIMS_VGPU_VK_DEVICE_NAME=<substring>` (ASCII case-insensitive) narrows
+///   the field to candidates whose name contains it;
+/// - `REIMS_VGPU_VK_DEVICE_TYPE=integrated|discrete|virtual|cpu` narrows it to
+///   that device type.
+///
+/// Both are A/B knobs rather than policy, and they are here because the ranking
+/// is right in general and wrong for a specific job: this host's discrete GPU
+/// has a 16 GB `DEVICE_LOCAL` heap that the device fills to
+/// `VK_ERROR_OUT_OF_DEVICE_MEMORY` under a 3D title, while the integrated GPU
+/// beside it reports ~46 GB of unified memory. Which of those is the better rail
+/// is a question to measure, so the answer has to be selectable at run time. A
+/// variable that matches nothing leaves the ranked field intact — a typo must
+/// not leave the device with no GPU at all — and `vk_device_preference` says
+/// which filter was active and how many candidates it kept.
 pub fn select_physical_device<T: Copy>(
     candidates: &[(u32, vk::PhysicalDeviceType, T)],
+    names: &[String],
 ) -> Result<(T, u32), Vec<u32>> {
+    let preference = DevicePreference::from_env();
     let mut below_floor = Vec::new();
     let mut best: Option<(u8, T, u32)> = None;
-    for (api, device_type, payload) in candidates {
+    for (index, (api, device_type, payload)) in candidates.iter().enumerate() {
         if !meets_floor(*api) {
             below_floor.push(*api);
             continue;
         }
+        if !preference.admits(*device_type, names.get(index).map_or("", String::as_str)) {
+            continue;
+        }
         let rank = rank_physical_device(*device_type);
         if best.is_none_or(|(best_rank, _, _)| rank > best_rank) {
             best = Some((rank, *payload, *api));
         }
     }
+    // A filter that matched nothing is a typo, not an instruction to fail: the
+    // ranked field is tried again unfiltered, and the census names the fallback.
+    if best.is_none() && preference.is_active() {
+        preference.note_unmatched(candidates);
+        return select_physical_device(candidates, names);
+    }
     best.map(|(_, payload, api)| (payload, api))
         .ok_or(below_floor)
 }
 
+/// The run-time device filter described on [`select_physical_device`].
+///
+/// Read once per selection (both the engine and the window's present device
+/// select through here, and they must agree), so a variable set after the
+/// device exists cannot split the two.
+#[derive(Clone, Copy, Debug, Default)]
+struct DevicePreference {
+    name: Option<&'static str>,
+    device_type: Option<vk::PhysicalDeviceType>,
+}
+
+impl DevicePreference {
+    fn from_env() -> Self {
+        let name = std::env::var("REIMS_VGPU_VK_DEVICE_NAME")
+            .ok()
+            .filter(|value| !value.is_empty())
+            .map(|value| Box::leak(value.into_boxed_str()) as &'static str);
+        let device_type = std::env::var("REIMS_VGPU_VK_DEVICE_TYPE").ok().and_then(|value| {
+            match value.to_ascii_lowercase().as_str() {
+                "discrete" => Some(vk::PhysicalDeviceType::DISCRETE_GPU),
+                "integrated" => Some(vk::PhysicalDeviceType::INTEGRATED_GPU),
+                "virtual" => Some(vk::PhysicalDeviceType::VIRTUAL_GPU),
+                "cpu" => Some(vk::PhysicalDeviceType::CPU),
+                _ => None,
+            }
+        });
+        Self { name, device_type }
+    }
+
+    fn is_active(self) -> bool {
+        self.name.is_some() || self.device_type.is_some()
+    }
+
+    fn admits(self, device_type: vk::PhysicalDeviceType, name: &str) -> bool {
+        if let Some(wanted) = self.name {
+            if !name.to_ascii_lowercase().contains(&wanted.to_ascii_lowercase()) {
+                return false;
+            }
+        }
+        if let Some(wanted) = self.device_type {
+            if device_type != wanted {
+                return false;
+            }
+        }
+        true
+    }
+
+    fn note_unmatched<T>(self, candidates: &[(u32, vk::PhysicalDeviceType, T)]) {
+        let names: Vec<String> = candidates
+            .iter()
+            .map(|(_, device_type, _)| format!("{device_type:?}"))
+            .collect();
+        crate::observe::off(format!(
+            "vk_device_preference_unmatched name={:?} type={:?} candidates=[{}] \
+             (the filter matched no device that clears the API floor; the ranked \
+              field is used instead)",
+            self.name,
+            self.device_type,
+            names.join(", ")
+        ));
+    }
+}
