     use super::*;
 
+    /// The ranker with no operator filter, which is what every pre-existing
+    /// assertion below is about.
+    fn select_physical_device_without_preference<T: Copy>(
+        candidates: &[(u32, vk::PhysicalDeviceType, T)],
+    ) -> Result<(T, u32), Vec<u32>> {
+        select_physical_device(candidates, &vec![String::new(); candidates.len()])
+    }
+
+    /// The filter is an operator knob, and the two answers it can give are the
+    /// whole of it: a field narrowed to the requested type, and the *ranked*
+    /// field when the request names nothing that exists.
+    #[test]
+    fn a_device_type_preference_narrows_the_field_or_falls_back_to_the_rank() {
+        use vk::PhysicalDeviceType as T;
+        let field = [
+            (vk::API_VERSION_1_3, T::DISCRETE_GPU, 0usize),
+            (vk::API_VERSION_1_3, T::INTEGRATED_GPU, 1usize),
+        ];
+        let names = vec!["discrete".to_string(), "integrated".to_string()];
+        // No variable set: the ranking wins, as it does today.
+        assert_eq!(select_physical_device(&field, &names).unwrap().0, 0);
+        // `integrated` is admitted only when asked for by type...
+        let preference = DevicePreference {
+            name: None,
+            device_type: Some(T::INTEGRATED_GPU),
+        };
+        assert!(preference.admits(T::INTEGRATED_GPU, "integrated"));
+        assert!(!preference.admits(T::DISCRETE_GPU, "discrete"));
+        // ...or by name, case-insensitively, against the device's own name.
+        let preference = DevicePreference {
+            name: Some("INTEL"),
+            device_type: None,
+        };
+        assert!(preference.admits(T::INTEGRATED_GPU, "Intel(R) Graphics (ARL)"));
+        assert!(!preference.admits(T::DISCRETE_GPU, "NVIDIA GeForce RTX 5080 Laptop GPU"));
+    }
