-    layout.read_x = viewport[0];
-    layout.read_y = viewport[1];
-    layout.width = static_cast<uint32_t>(viewport[2]);
-    layout.height = static_cast<uint32_t>(viewport[3]);
-  } else {
-    // Fallback: use the EGL surface dimensions
