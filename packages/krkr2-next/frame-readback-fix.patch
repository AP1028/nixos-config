@@ -419,6 +414,17 @@ bool ReadCurrentFrameRgba(const FrameReadbackLayout& layout, void* out_pixels) {
     return false;
   }
 
+  // Read the composed screen: bind the default framebuffer and set a viewport
+  // that matches the surface, so the grab cannot pick up a layer texture or a
+  // stale viewport left behind by the renderer.
+  GLint previous_fbo = 0;
+  GLint previous_viewport[4] = {0, 0, 0, 0};
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previous_fbo);
+  glGetIntegerv(GL_VIEWPORT, previous_viewport);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glViewport(0, 0, static_cast<GLsizei>(layout.width),
