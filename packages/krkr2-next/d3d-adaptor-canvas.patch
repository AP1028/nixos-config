+        // Sub-image layers of the captured canvas, so scripts that walk them
+        // get an (empty) array to iterate instead of an integer.
+        static tjs_error getSubImageLayers(tTJSVariant *result, tjs_int,
+                                           tTJSVariant **,
+                                           iTJSDispatch2 *objthis) {
+            auto *self = ncbInstanceAdaptor<D3DAdaptor>::GetNativeInstance(objthis, true);
+            if(self && self->_canvas) {
+                tTJSVariant value;
+                const tjs_error hr = self->_canvas->PropGet(
+                    0, TJS_W("subImageLayers"), nullptr, &value, self->_canvas);
+                if(TJS_SUCCEEDED(hr) && value.Type() == tvtObject) {
+                    if(result) *result = value;
+                    return TJS_S_OK;
+                }
+            }
+            if(result) {
+                iTJSDispatch2 *array = TJSCreateArrayObject();
+                if(array) {
+                    *result = tTJSVariant(array);
+                    array->Release();
+                } else {
+                    *result = tTJSVariant();
+                }
+            }
+            return TJS_S_OK;
+        }
+
+#define KRKR_D3D_FORWARD_METHOD(NAME)                                          \
+    static tjs_error NAME(tTJSVariant *result, tjs_int count,                  \
+                          tTJSVariant **param, iTJSDispatch2 *objthis) {       \
+        auto *self = ncbInstanceAdaptor<D3DAdaptor>::GetNativeInstance(objthis, true); \
+        return ForwardFuncCall(self ? self->_canvas : nullptr, TJS_W(#NAME),    \
+                               result, count, param, #NAME);                    \
+    }
