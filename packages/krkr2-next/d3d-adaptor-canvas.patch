 namespace motion {
+    // Helpers for exposing the canvas a D3DAdaptor was bound to. Yuzusoft's
+    // KAG scripts hand the adapter a Layer through captureCanvas() and then
+    // read that layer's raw pixel buffer and geometry back through the adapter
+    // (mainImageBuffer / mainImageBufferPitch / width / height) in order to
+    // composite the motion into it, so these have to answer with the canvas'
+    // values instead of a constant.
+    inline tjs_error ForwardPropGet(iTJSDispatch2 *target, const tjs_char *name,
+                                    tTJSVariant *result) {
+        if(!target) {
+            if(result)
+                *result = tTJSVariant(static_cast<tjs_int>(0));
+            return TJS_S_OK;
+        }
+        tTJSVariant value;
+        const tjs_error hr = target->PropGet(0, name, nullptr, &value, target);
+        LOGGER->debug("D3DAdaptor: canvas read {} -> {} ({})",
+                      ttstr(name).AsStdString(),
+                      TJS_SUCCEEDED(hr) ? static_cast<int>(value.Type()) : -1,
+                      TJS_SUCCEEDED(hr) ? ttstr(value).AsStdString() : "missing");
+        if(result) {
+            *result = TJS_SUCCEEDED(hr) ? value
+                                        : tTJSVariant(static_cast<tjs_int>(0));
+        }
+        return TJS_S_OK;
+    }
+
+    inline tjs_error ForwardFuncCall(iTJSDispatch2 *target, const tjs_char *name,
+                                     tTJSVariant *result, tjs_int count,
+                                     tTJSVariant **param, const char *log_name) {
+        LOGGER->debug("D3DAdaptor::{} ({} args) canvas={}", log_name, count,
+                      static_cast<const void *>(target));
+        if(!target) {
+            if(result)
+                *result = tTJSVariant(static_cast<tjs_int>(0));
+            return TJS_S_OK;
+        }
+        // Forward when the canvas implements the member, otherwise behave the
+        // way the previous no-op stub did: answering with an error here turns
+        // into a script exception in the game's paint path.
+        const tjs_error hr =
+            target->FuncCall(0, name, nullptr, result, count, param, target);
+        if(TJS_FAILED(hr)) {
+            LOGGER->debug("D3DAdaptor::{} not handled by canvas ({:#x})",
+                          log_name, static_cast<unsigned>(hr));
+            if(result)
+                *result = tTJSVariant(static_cast<tjs_int>(0));
+            return TJS_S_OK;
+        }
+        return hr;
+    }
+
