+namespace {
+    // Lowercased file name of a plugin request, which may be a bare name or a
+    // full path into the game's plugin directory.
+    std::string PluginBaseNameLower(const ttstr &name) {
+        std::string s = name.AsStdString();
+        const auto slash = s.find_last_of("/\\");
+        if(slash != std::string::npos)
+            s = s.substr(slash + 1);
+        std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) {
+            return static_cast<char>(std::tolower(c));
+        });
+        return s;
+    }
+} // namespace
