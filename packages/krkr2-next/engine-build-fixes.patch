+// symbol, so provide a zero-initialised instance in that case.
+#include <EGL/egl.h>
+#include <GLES2/gl2.h>
+
+struct Live2DRenderTarget {
+    GLuint fbo = 0;
+    GLsizei width = 0;
+    GLsizei height = 0;
+};
+
+Live2DRenderTarget g_live2dRenderTarget;
