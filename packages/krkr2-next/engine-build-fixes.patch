+
+tTVPArchive *TVPOpen7ZArchive(const ttstr &name, tTJSBinaryStream *st,
+                              bool normalizeFileName) {
+    (void)name;
+    (void)st;
+    (void)normalizeFileName;
+    return nullptr;
+}
