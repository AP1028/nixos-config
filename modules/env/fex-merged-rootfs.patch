+bool FileManager::IsProcMapsFile(const char* Pathname) const {
+  if (!Pathname) {
+    return false;
+  }
+
+  // In merged-rootfs mode FEX opens proc files through the rootfs path
+  // (e.g. /run/fex-emu/rootfs/proc/<pid>/maps), so strip that prefix first.
+  const auto& RootFS = LDPath();
+  if (!RootFS.empty()) {
+    size_t RootFSLen = RootFS.size();
+    if (RootFSLen != 0 && RootFS[RootFSLen - 1] == '/') {
+      RootFSLen -= 1;
+    }
+    if (strncmp(Pathname, RootFS.c_str(), RootFSLen) == 0 && (Pathname[RootFSLen] == '/' || Pathname[RootFSLen] == '\0')) {
+      Pathname += RootFSLen;
+    }
+  }
+
+  if (strncmp(Pathname, "/proc/", 6) != 0) {
+    return false;
+  }
+
+  const char* Base = strrchr(Pathname, '/');
+  if (!Base) {
+    return false;
+  }
+  ++Base;
+
+  return strcmp(Base, "maps") == 0 || strcmp(Base, "smaps") == 0 || strcmp(Base, "smaps_rollup") == 0 || strcmp(Base, "numa_maps") == 0;
+}
+
+bool FileManager::RewriteProcMapsFD(int FD) const {
+  const auto& RootFS = LDPath();
+  if (RootFS.empty()) {
+    return false;
+  }
+
+  fextl::string Prefix = RootFS;
+  while (!Prefix.empty() && Prefix.back() == '/') {
+    Prefix.pop_back();
+  }
+  if (Prefix.empty()) {
+    return false;
+  }
+
+  // Read the entire file (maps files are finite and bounded).
+  fextl::string Content;
+  char Buffer[16384];
+  lseek(FD, 0, SEEK_SET);
+  for (;;) {
+    auto Read = ::read(FD, Buffer, sizeof(Buffer));
+    if (Read > 0) {
+      Content.append(Buffer, Read);
+    } else if (Read == 0) {
+      break;
+    } else if (errno == EINTR) {
+      continue;
+    } else {
+      return false;
+    }
+  }
+  lseek(FD, 0, SEEK_SET);
+
+  // Replace every "<RootFS>/" occurrence with "/" so that the merged rootfs
+  // prefix is hidden from the guest (e.g. "/run/fex-emu/rootfs/usr/lib64/libc.so.6"
+  // becomes "/usr/lib64/libc.so.6").
+  fextl::string Needle = Prefix + "/";
+  fextl::string Out;
+  Out.reserve(Content.size());
+
+  size_t Pos = 0;
+  for (;;) {
+    auto Found = Content.find(Needle, Pos);
+    if (Found == fextl::string::npos) {
+      Out.append(Content, Pos, fextl::string::npos);
+      break;
+    }
+    Out.append(Content, Pos, Found - Pos);
+    Out += '/';
+    Pos = Found + Needle.size();
+  }
+
+  int MemFD = memfd_create("fex-maps", MFD_CLOEXEC);
+  if (MemFD == -1) {
+    return false;
+  }
+
+  size_t Written = 0;
+  while (Written < Out.size()) {
+    auto W = ::write(MemFD, Out.data() + Written, Out.size() - Written);
+    if (W > 0) {
+      Written += W;
+    } else if (W < 0 && errno == EINTR) {
+      continue;
+    } else {
+      ::close(MemFD);
+      return false;
+    }
+  }
+
+  lseek(MemFD, 0, SEEK_SET);
+  ::dup2(MemFD, FD);
+  ::close(MemFD);
+  return true;
+}
