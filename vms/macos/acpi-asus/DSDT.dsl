                Method (FHRF, 1, NotSerialized)
                {
                    If ((GGOV (PRST) != WPRP))
                    {
                        DL23 ()
                        ADBG ("WWAN DL23() Done")
                        SGOV (PRST, WPRP)
                        ADBG ("WWAN PERST:0 Done")
