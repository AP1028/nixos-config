                        MSNL = DR01 /* \DR01 */
                        L1C1 = DR02 /* \DR02 */
                        L1C2 = DR03 /* \DR03 */
                        PTMR = DR04 /* \DR04 */
                        Sleep (0x07D0)
                    }
