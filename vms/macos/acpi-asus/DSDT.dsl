                        Return (WFRC) /* \WFRC */
                    }

                    If ((Arg2 == 0x05))
                    {
                        Return (WFUC) /* \WFUC */
                    }

                    If ((Arg2 == 0x07))
                    {
                        Return (UNI4) /* \UNI4 */
                    }

                    If ((Arg2 == 0x08))
                    {
                        Return (WFIC) /* \WFIC */
                    }

                    If ((Arg2 == 0x09))
                    {
                        Return (WFBS) /* \WFBS */
                    }

                    If ((Arg2 == 0x0A))
                    {
                        Return (WEDT) /* \WEDT */
                    }

                    If ((Arg2 == 0x0B))
                    {
                        Return (0x03)
                        If (CondRefOf (DRIE))
                        {
                            If (CondRefOf (CRFI))
                            {
                                If (((DRIE == One) && (CRFI == One)))
                                {
                                    Return (Zero)
                                }
                                ElseIf (((DRIE == Zero) && (CRFI == One)))
                                {
                                    Return (One)
                                }
                                ElseIf (((DRIE == One) && (CRFI == Zero)))
                                {
                                    Return (0x02)
                                }
                                ElseIf (((DRIE == Zero) && (CRFI == Zero)))
                                {
                                    Return (0x03)
                                }
                            }
                        }

                        Return (Zero)
                    }

                    If ((Arg2 == 0x0C))
