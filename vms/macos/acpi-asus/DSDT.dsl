                                /* 01E8 */  0x36, 0x2E, 0x56, 0x47, 0x50, 0x31, 0x00, 0x8C,  // 6.VGP1..
                                /* 01F0 */  0x34, 0x00, 0x01, 0x01, 0x01, 0x00, 0x00, 0x00,  // 4.......
                                /* 01F8 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x17, 0x00, 0x00,  // ........
                                /* 0200 */  0x19, 0x00, 0x37, 0x00, 0x00, 0x00, 0x09, 0x00,  // ..7.....
                                /* 0208 */  0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x50, 0x43, 0x30,  // \_SB.PC0
                                /* 0210 */  0x30, 0x2E, 0x58, 0x48, 0x43, 0x49, 0x2E, 0x52,  // 0.XHCI.R
                                /* 0218 */  0x48, 0x55, 0x42, 0x2E, 0x48, 0x53, 0x30, 0x36,  // HUB.HS06
