        Method (SFMN, 0, Serialized)
        {
            If (CondRefOf (\_SB.NPCF))
            {
                Switch (ToInteger (FTBL))
                {
                    Case (0x02)
                    {
                        CPUP (0xF0)
                        SSSM ()
                        DGPS (0x02)
                    }
                    Case (One)
                    {
                        CPUP (0x0118)
                        STDM ()
                        DGPS (One)
                    }
                    Case (Zero)
                    {
                        CPUP (0xF0)
                        SPDM ()
                        DGPS (One)
                    }

                }

                Sleep (0x64)
                Notify (NPCF, 0xC0) // Hardware-Specific
                Sleep (0x64)
                WMSH ()
                Sleep (0x64)
                STPL ()
                Sleep (0x64)
                Notify (NPCF, 0xC0) // Hardware-Specific
                TTT1 = ^^^^NPCF.AMAT /* External reference */
                TTT2 = ^^^^NPCF.ACBT /* External reference */
            }
        }

        Method (STDM, 0, NotSerialized)
        {
            If (CondRefOf (\_SB.NPCF))
            {
                ^^^^NPCF.AMAT = 0xA0
                ^^^^NPCF.ACBT = 0xA0
                ^^^^NPCF.ATPP = 0x0118
                SPAB (One)
            }
        }

        Method (SPDM, 0, NotSerialized)
        {
            If (CondRefOf (\_SB.NPCF))
            {
                ^^^^NPCF.AMAT = 0x50
                ^^^^NPCF.ACBT = Zero
                ^^^^NPCF.ATPP = 0xF0
                If ((ACIN == One))
                {
                    SPAB (One)
                }
                Else
                {
                    SPAB (Zero)
                }
            }
        }

        Method (SSSM, 0, NotSerialized)
        {
            If (CondRefOf (\_SB.NPCF))
            {
                ^^^^NPCF.AMAT = 0x50
                ^^^^NPCF.ACBT = Zero
                ^^^^NPCF.ATPP = 0xF0
                If ((ACIN == One))
                {
                    SPAB (One)
                }
                ElseIf ((RSOC > 0x32))
                {
                    SPAB (One)
                }
                Else
                {
                    SPAB (Zero)
                }
            }
        }

        Method (SMSM, 0, NotSerialized)
        {
            If (CondRefOf (\_SB.NPCF))
            {
                ^^^^NPCF.AMAT = 0xA0
                ^^^^NPCF.ACBT = 0xF0
                ^^^^NPCF.ATPP = 0x0118
                SPAB (One)
                DGPS (One)
            }
        }

        Method (STPL, 0, NotSerialized)
        {
            If ((FTBL == 0x02))
            {
                ^^^^NPCF.TPPL = 0x0001C138
                If ((ACIN == One))
                {
                    SPAB (One)
                }
                ElseIf ((RSOC > 0x32))
                {
                    SPAB (One)
                }
                Else
                {
                    SPAB (Zero)
                }
            }
            Else
            {
                If ((FTBL == Zero))
                {
                    ^^^^NPCF.TPPL = 0x0001C138
                }

                If ((ACIN == One))
                {
                    SPAB (One)
                }
                Else
                {
                    SPAB (Zero)
                }
            }
        }

        Method (WMSH, 0, NotSerialized)
        {
            TGSF = Zero
            FGWM = Zero
            NTWF = Zero
            If ((FMAE == Zero))
            {
                If ((FTBL == 0x02))
                {
                    FGWM = Zero
                    NTWF = One
                }
                ElseIf ((FTBL == Zero))
                {
                    FGWM = One
                    NTWF = One
                }
                ElseIf ((FTBL == One))
                {
                    FGWM = Zero
                    NTWF = One
                }
            }
            Else
            {
                FGWM = Zero
                NTWF = One
            }

            QCHK = 0xD4
        }

        Method (SPAB, 1, NotSerialized)
        {
            If (CondRefOf (\_SB.NPCF))
            {
                If ((Arg0 == Zero))
                {
                    ^^^^NPCF.DBAC = One
                    ^^^^NPCF.DBDC = One
                }

                If ((Arg0 == One))
                {
                    ^^^^NPCF.DBAC = Zero
                    ^^^^NPCF.DBDC = Zero
                }

                Notify (NPCF, 0xC0) // Hardware-Specific
            }
        }

        Name (DFLG, 0xD1)
        Method (DNOT, 1, Serialized)
        {
            If (CondRefOf (\_SB.PC00.RP12.PXSX))
            {
                If ((SDNT != One))
                {
                    Return (Zero)
                }

                Local0 = Arg0
                If (((Local0 >= 0xD1) && (Local0 <= 0xD5)))
                {
                    If ((DFLG != Local0))
                    {
                        P80B = Local0
                        ECMD (0xAE)
                        Notify (^^^RP12.PXSX, Local0)
                        ECMD (0xAD)
                        DFLG = Local0
                    }
                }
            }
        }

        Method (WAT1, 0, Serialized)
        {
            Local0 = Zero
            While ((WOSR == One))
            {
                Sleep (0x64)
                Local0++
                If ((Local0 == 0x96))
                {
                    WOSR = Zero
                    Return (One)
                }
            }

            Return (Zero)
        }

        Method (WAT2, 0, Serialized)
        {
            Local0 = Zero
            While ((Local0 < 0x01F4))
            {
                Sleep (0x0F)
                Local0++
                If ((^^^RP12.NCHK (VEND, DEID) == Zero))
                {
                    Return (One)
                }
            }

            Return (Zero)
        }

        Method (CPUP, 1, NotSerialized)
        {
            If (CondRefOf (\_SB.NPCF))
            {
                ^^^^NPCF.ATPP = Arg0
                ^^^^NPCF.DTPP = Arg0
            }
        }

        Name (FMTG, Package (0x04)
        {
            Zero, 
            0x57, 
            0x4B, 
            0x57
        })
        Method (DGPS, 1, NotSerialized)
        {
            If (CondRefOf (\_SB.PC00.RP12.PXSX))
            {
                ^^^RP12.PXSX.NLIM = One
                ^^^RP12.PXSX.TGPU = DerefOf (FMTG [Arg0])
                Notify (^^^RP12.PXSX, 0xC0) // Hardware-Specific
            }
        }
    }

    Method (XPTS, 1, NotSerialized)
    {
    }

    Method (XWAK, 1, NotSerialized)
    {
    }

    Scope (_SB.PC00.LPCB)
    {
        Device (PS2K)
        {
            Name (_HID, "MSFT0001")  // _HID: Hardware ID
            Name (_CID, EisaId ("PNP0303") /* IBM Enhanced Keyboard (101/102-key, PS/2 Mouse) */)  // _CID: Compatible ID
            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                Return (0x0F)
            }

            Name (_CRS, Buffer (0x15)  // _CRS: Current Resource Settings
            {
                /* 0000 */  0x47, 0x01, 0x60, 0x00, 0x60, 0x00, 0x00, 0x01,  // G.`.`...
                /* 0008 */  0x47, 0x01, 0x64, 0x00, 0x64, 0x00, 0x00, 0x01,  // G.d.d...
                /* 0010 */  0x22, 0x02, 0x00, 0x79, 0x00                     // "..y.
            })
            Name (_PRS, Buffer (0x18)  // _PRS: Possible Resource Settings
            {
                /* 0000 */  0x31, 0x00, 0x47, 0x01, 0x60, 0x00, 0x60, 0x00,  // 1.G.`.`.
                /* 0008 */  0x00, 0x01, 0x47, 0x01, 0x64, 0x00, 0x64, 0x00,  // ..G.d.d.
                /* 0010 */  0x00, 0x01, 0x22, 0x02, 0x00, 0x38, 0x79, 0x00   // .."..8y.
            })
        }
    }

    Scope (\)
    {
        Name (KBFG, One)
    }
}

