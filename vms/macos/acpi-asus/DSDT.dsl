    Scope (_TZ)
    {
        Device (FAN0)
        {
            Name (_HID, EisaId ("PNP0C0B") /* Fan (Thermal Solution) */)  // _HID: Hardware ID
            Name (LRPM, Zero)
            Name (URPM, Zero)
            Name (CFST, Package (0x03)
            {
                Zero, 
                Zero, 
                Zero
            })
            Name (GRAN, 0x01F4)
            Name (FOPR, Package (0x04)
            {
                0x0960, 
                0x0A28, 
                0x0C1C, 
                0x0D48
            })
            Method (CRNF, 0, NotSerialized)
            {
                \_SB.PC00.LPCB.EC0.LRP1 = LRPM /* \_TZ_.FAN0.LRPM */
                \_SB.PC00.LPCB.EC0.URP1 = URPM /* \_TZ_.FAN0.URPM */
            }

            Method (GCFR, 0, NotSerialized)
            {
                Acquire (\_SB.PC00.LPCB.EC0.MUT0, 0x1000)
                Local0 = \_SB.PC00.LPCB.EC0.FRMS
                Release (\_SB.PC00.LPCB.EC0.MUT0)
                Return (Local0)
            }

            Method (_FST, 0, NotSerialized)  // _FST: Fan Status
            {
                Local0 = GCFR ()
                CFST [0x02] = Local0
                If ((Local0 > DerefOf (FOPR [0x02])))
                {
                    CFST [One] = 0x04
                }
                ElseIf ((Local0 > DerefOf (FOPR [One])))
                {
                    CFST [One] = 0x03
                }
                ElseIf ((Local0 > DerefOf (FOPR [Zero])))
                {
                    CFST [One] = 0x02
                }
                ElseIf ((Local0 <= DerefOf (FOPR [Zero])))
                {
                    CFST [One] = One
                }

                Return (CFST) /* \_TZ_.FAN0.CFST */
            }

            Method (SFST, 0, NotSerialized)
            {
                Notify (FAN0, 0x80) // Status Change
            }

            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                If ((Arg0 == ToUUID ("a7611840-99fe-41ae-a488-35c75926c8eb") /* Fan Trip Points */))
                {
                    Switch (ToInteger (Arg2))
                    {
                        Case (Zero)
                        {
                            Return (Buffer (One)
                            {
                                 0x0F                                             // .
                            })
                        }
                        Case (One)
                        {
                            Return (GRAN) /* \_TZ_.FAN0.GRAN */
                        }
                        Case (0x02)
                        {
                            Local0 = GCFR ()
                            If ((Local0 > DerefOf (FOPR [0x02])))
                            {
                                LRPM = 0x0C1C
                                URPM = 0x0D48
                            }
                            ElseIf ((Local0 > DerefOf (FOPR [One])))
                            {
                                LRPM = 0x0A28
                                URPM = 0x0C1C
                            }
                            ElseIf ((Local0 > DerefOf (FOPR [Zero])))
                            {
                                LRPM = 0x0960
                                URPM = 0x0A28
                            }
                            ElseIf ((Local0 <= DerefOf (FOPR [Zero])))
                            {
                                LRPM = One
                                URPM = 0x0960
                            }

                            CRNF ()
                            Return (Zero)
                        }
                        Case (0x03)
                        {
                            Return (FOPR) /* \_TZ_.FAN0.FOPR */
                        }
                        Default
                        {
                            Return (Buffer (One)
                            {
                                 0x00                                             // .
                            })
                        }

                    }
                }
                Else
                {
                    Return (Buffer (One)
                    {
                         0x00                                             // .
                    })
                }
            }
        }
    }

