                                /* 0240 */  0x5F, 0x53, 0x42, 0x2E, 0x50, 0x43, 0x30, 0x30,  // _SB.PC00
                                /* 0248 */  0x2E, 0x58, 0x48, 0x43, 0x49, 0x2E, 0x52, 0x48,  // .XHCI.RH
                                /* 0250 */  0x55, 0x42, 0x2E, 0x48, 0x53, 0x30, 0x36, 0x2E,  // UB.HS06.
