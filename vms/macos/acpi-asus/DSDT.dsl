                    {
                        If ((VMS0 != Zero))
                        {
                            ADBG ("VMD SATA0 Ctrlr D0 - Clear LTR ignore bit for SATA")
                            ISAT = Zero
                            ADBG (Concatenate ("LTR ignore bit status = ", ToHexString (ISAT)))
                        }
                    }
                }

