                                /* 01C8 */  0x00, 0x19, 0x00, 0x37, 0x00, 0x00, 0x00, 0x08,  // ...7....
                                /* 01D0 */  0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x50, 0x43,  // .\_SB.PC
                                /* 01D8 */  0x30, 0x30, 0x2E, 0x58, 0x48, 0x43, 0x49, 0x2E,  // 00.XHCI.
