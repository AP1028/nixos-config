# Recommended production profile for Qwen3.8-27B-FP8 on gpu-vm.
# Highest measured decode on a real English prose smoke prompt (117 prompt /
# 128 generated tokens) while keeping MTP acceptance high.
# MODE=fast is used together with VLLM_ALLOW_MAMBA_SPEC_FULL_CUDAGRAPH=0 in
# run-vllm-qwen.sh; PIECEWISE graphs beat FULL_AND_PIECEWISE on Turing for
# this hybrid-linear-attention model.
SERVED_NAME=qwen38-27b-fp8-fast-mtp3
COMPATIBLE_MODES=fast
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen38-27b-fp8
MODEL_VARIANT=fp8
QUANTIZATION=fp8
MAX_MODEL_LEN=98304
GPU_UTIL=0.94
MAX_BATCHED_TOKENS=2048
MAX_NUM_SEQS=1
MTP_K=3
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
COMPILATION_CONFIG_JSON={"cudagraph_mode":"PIECEWISE","cudagraph_capture_sizes":[4],"max_cudagraph_capture_size":4}
