# Peak synthetic throughput preset for Qwen3.8-27B-FP8.
# PP128/TG128 pure-filler decode measured ~178 tok/s with sync mode auto.
# Natural-text acceptance drops (46.5 tok/s on the prose smoke prompt), so use
# this only for benchmark/peak runs; `fast` (MTP4) is the daily preset.
SERVED_NAME=qwen38-27b-fp8-peak-mtp12
COMPATIBLE_MODES=fast
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen38-27b-fp8
MODEL_VARIANT=fp8
QUANTIZATION=fp8
MAX_MODEL_LEN=98304
GPU_UTIL=0.95
MAX_BATCHED_TOKENS=2048
MAX_NUM_SEQS=1
MTP_K=12
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
COMPILATION_CONFIG_JSON={"cudagraph_mode":"PIECEWISE","cudagraph_capture_sizes":[13],"max_cudagraph_capture_size":13}
