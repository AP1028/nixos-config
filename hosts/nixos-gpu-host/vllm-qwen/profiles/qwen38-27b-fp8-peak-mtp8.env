# Peak synthetic throughput profile.  PP128/TG128 pure-filler decode measured
# ~141 tok/s (vs ~91 tok/s for MTP3).  MTP acceptance on natural text drops
# sharply at this depth: the same real-prose smoke prompt measures ~53 tok/s,
# so this is a benchmark/peak preset, not the daily mixed-workload preset.
SERVED_NAME=qwen38-27b-fp8-peak-mtp8
COMPATIBLE_MODES=fast
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen38-27b-fp8
MODEL_VARIANT=fp8
QUANTIZATION=fp8
MAX_MODEL_LEN=98304
GPU_UTIL=0.94
MAX_BATCHED_TOKENS=2048
MAX_NUM_SEQS=1
MTP_K=8
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
COMPILATION_CONFIG_JSON={"cudagraph_mode":"PIECEWISE","cudagraph_capture_sizes":[9],"max_cudagraph_capture_size":9}
