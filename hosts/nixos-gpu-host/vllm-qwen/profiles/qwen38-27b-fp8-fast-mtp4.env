# Fast preset for Qwen3.8-27B-FP8 on gpu-host.
# Best measured natural-text single-stream decode with strong synthetic peak.
# Requires run-vllm-qwen.sh's VLLM_SM75_SPEC_SYNC_MODE=auto and
# VLLM_ALLOW_MAMBA_SPEC_FULL_CUDAGRAPH=0.
SERVED_NAME=qwen38-27b-fp8-fast-mtp4
COMPATIBLE_MODES=fast
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen38-27b-fp8
MODEL_VARIANT=fp8
QUANTIZATION=fp8
MAX_MODEL_LEN=98304
GPU_UTIL=0.94
MAX_BATCHED_TOKENS=2048
MAX_NUM_SEQS=1
MTP_K=4
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
COMPILATION_CONFIG_JSON={"cudagraph_mode":"PIECEWISE","cudagraph_capture_sizes":[5],"max_cudagraph_capture_size":5}
