# Balanced speed profile: MTP4 keeps real-prose decode at MTP3 level
# (64.3 tok/s measured) but raises pure-filler synthetic decode to ~104 tok/s.
SERVED_NAME=qwen38-27b-fp8-balanced-mtp4
COMPATIBLE_MODES=fast
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen38-27b-fp8
MODEL_VARIANT=fp8
QUANTIZATION=fp8
MAX_MODEL_LEN=98304
GPU_UTIL=0.94
MAX_BATCHED_TOKENS=2048
MAX_NUM_SEQS=1
MTP_K=4
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
COMPILATION_CONFIG_JSON={"cudagraph_mode":"PIECEWISE","cudagraph_capture_sizes":[5],"max_cudagraph_capture_size":5}
